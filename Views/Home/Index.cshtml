@model List<project_18.Models.Product>
@{
    ViewData["Title"] = "Home - Product Catalog";
    var categories = ViewBag.Categories as List<project_18.Models.Category> ?? new List<project_18.Models.Category>();
    int selectedCategory = ViewBag.SelectedCategory;
    string searchQuery = ViewBag.SearchQuery;
}

<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <h2 class="fw-bold text-dark">🛍️ Used Goods Catalog</h2>
        <p class="text-muted">Browse and buy unique, high-quality used items!</p>
    </div>
    <div class="col-md-6">
        <form method="get" asp-controller="Home" asp-action="Index" class="d-flex gap-2">
            <input type="hidden" name="categoryId" value="@selectedCategory" />
            <input type="text" name="search" value="@searchQuery" class="form-control" placeholder="Search for products..." />
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(searchQuery) || selectedCategory > 0)
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Reset</a>
            }
        </form>
    </div>
</div>

<!-- Category Pills -->
<div class="mb-4">
    <a href="@Url.Action("Index", "Home", new { categoryId = 0, search = searchQuery })" 
       class="btn btn-sm @(selectedCategory == 0 ? "btn-primary" : "btn-outline-primary") me-2 mb-2">All</a>
    
    @foreach (var cat in categories)
    {
        <a href="@Url.Action("Index", "Home", new { categoryId = cat.CategoryId, search = searchQuery })" 
           class="btn btn-sm @(selectedCategory == cat.CategoryId ? "btn-primary" : "btn-outline-primary") me-2 mb-2">@cat.Name</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-warning text-center py-4">
        <h5>No products found matching your search.</h5>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100 product-card @(product.IsSold ? "sold-out" : "")">
                    
                    @if (product.IsSold)
                    {
                        <div class="sold-out-overlay">
                            <div class="sold-out-stamp">SOLD OUT</div>
                        </div>
                    }

                    <img src="@product.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@product.Name" onerror="this.src='/images/placeholder.png';" />
                    
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            @if (product.Condition == "Excellent")
                            {
                                <span class="badge bg-success">Excellent</span>
                            }
                            else if (product.Condition == "Very Good")
                            {
                                <span class="badge bg-info text-dark">Very Good</span>
                            }
                            else if (product.Condition == "Good")
                            {
                                <span class="badge bg-warning text-dark">Good</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Acceptable</span>
                            }
                        </div>
                        
                        <h5 class="card-title fw-bold text-truncate">@product.Name</h5>
                        <p class="card-text text-muted small text-truncate">@product.Description</p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                            <span class="fs-5 fw-bold text-success">₪ @product.Price.ToString("F2")</span>
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-outline-primary btn-sm">Details</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}




