@model project_18.Models.User
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5">
        <div class="card p-4 shadow-sm">
            <h3 class="fw-bold text-center text-dark mb-4">📝 Register New Account</h3>

            <form method="post" asp-controller="Account" asp-action="Register">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" required placeholder="Enter your full name..." />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Username</label>
                    <input asp-for="Username" class="form-control" required placeholder="Enter a unique username..." />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" required placeholder="Choose a password..." />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mb-3">Register</button>
            </form>

            <div class="text-center mt-2">
                <span class="text-muted">Already have an account?</span>
                <a asp-controller="Account" asp-action="Login" class="text-primary fw-bold text-decoration-none ms-1">Login here</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}




