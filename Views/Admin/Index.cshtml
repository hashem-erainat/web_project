@model List<project_18.Models.Product>
@{
    ViewData["Title"] = "Admin Dashboard";
    var categories = ViewBag.Categories as List<project_18.Models.Category> ?? new List<project_18.Models.Category>();
    var allOrders = ViewBag.AllOrders as List<project_18.Models.Order> ?? new List<project_18.Models.Order>();
    decimal totalSales = ViewBag.TotalSales;
    int availableCount = ViewBag.AvailableCount;
    int soldCount = ViewBag.SoldCount;
}

<h2 class="fw-bold text-dark mb-4">⚙️ Admin Dashboard</h2>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card bg-success text-white shadow-sm">
            <div class="card-body py-4">
                <h6 class="card-subtitle mb-2 opacity-75">Total Sales</h6>
                <h2 class="card-title fw-bold">₪ @totalSales.ToString("F2")</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-primary text-white shadow-sm">
            <div class="card-body py-4">
                <h6 class="card-subtitle mb-2 opacity-75">Active Products</h6>
                <h2 class="card-title fw-bold">@availableCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-danger text-white shadow-sm">
            <div class="card-body py-4">
                <h6 class="card-subtitle mb-2 opacity-75">Sold Products</h6>
                <h2 class="card-title fw-bold">@soldCount</h2>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- Add Product Form -->
    <div class="col-md-8">
        <div class="card p-4 shadow-sm h-100">
            <h4 class="fw-bold text-dark mb-3 border-bottom pb-2">➕ Add New Product</h4>
            <form method="post" asp-controller="Admin" asp-action="AddProduct">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Product Name</label>
                        <input type="text" name="Name" class="form-control" required placeholder="e.g. Retro Film Camera" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Price (₪)</label>
                        <input type="number" step="0.01" name="Price" class="form-control" required placeholder="0.00" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Product Category</label>
                        <select name="CategoryId" class="form-select" required>
                            <option value="">Select Category...</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.CategoryId">@cat.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Product Condition</label>
                        <select name="Condition" class="form-select" required>
                            <option value="Excellent">Excellent</option>
                            <option value="Very Good">Very Good</option>
                            <option value="Good" selected>Good</option>
                            <option value="Acceptable">Acceptable</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Product Image URL</label>
                        <input type="text" name="ImageUrl" class="form-control" placeholder="Enter image link, or leave blank for default image" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea name="Description" class="form-control" rows="3" required placeholder="Add product description and condition details..."></textarea>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary px-4">Save & Add Product</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Add Category Form -->
    <div class="col-md-4">
        <div class="card p-4 shadow-sm mb-4">
            <h4 class="fw-bold text-dark mb-3 border-bottom pb-2">➕ Add New Category</h4>
            <form method="post" asp-controller="Admin" asp-action="AddCategory">
                <div class="mb-3">
                    <label class="form-label">Category Name</label>
                    <input type="text" name="name" class="form-control" required placeholder="e.g. Games" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Save Category</button>
            </form>
        </div>
        
        <div class="card p-4 shadow-sm" style="max-height: 250px; overflow-y: auto;">
            <h5 class="fw-bold text-dark mb-3">Current Categories</h5>
            <ul class="list-group">
                @foreach (var cat in categories)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span>@cat.Name</span>
                        <span class="badge bg-secondary">ID: @cat.CategoryId</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<!-- Products Table -->
<div class="card p-4 shadow-sm mb-5">
    <h4 class="fw-bold text-dark mb-3 border-bottom pb-2">📁 Manage Products</h4>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Product ID</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Condition</th>
                    <th>Date Added</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.ProductId</td>
                        <td class="fw-bold">@item.Name</td>
                        <td>@item.Category?.Name</td>
                        <td class="text-success fw-bold">₪ @item.Price.ToString("F2")</td>
                        <td>@item.Condition</td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("d")</td>
                        <td>
                            @if (item.IsSold)
                            {
                                <span class="badge bg-danger">Sold 🚫</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Available ✅</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Sales Log Table -->
<div class="card p-4 shadow-sm">
    <h4 class="fw-bold text-dark mb-3 border-bottom pb-2">🧾 Sales & Orders Log</h4>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Product Name</th>
                    <th>Purchase Date</th>
                    <th>Amount</th>
                    <th>Order Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in allOrders)
                {
                    <tr>
                        <td>#@order.OrderId</td>
                        <td>
                            <div class="fw-bold">@order.User?.FullName</div>
                            <span class="text-muted small">@@@order.User?.Username</span>
                        </td>
                        <td class="fw-bold">@order.Product?.Name</td>
                        <td>@order.PurchaseDate.ToLocalTime().ToString("g")</td>
                        <td class="text-success fw-bold">₪ @order.TotalPrice.ToString("F2")</td>
                        <td>
                            @if (order.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark mb-2">Pending Approval</span>
                                <div class="d-flex gap-1">
                                    <form method="post" asp-controller="Admin" asp-action="ApproveOrder">
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <button type="submit" class="btn btn-success btn-sm py-0 px-2 fw-bold" style="font-size: 0.75rem;">Approve</button>
                                    </form>
                                    <form method="post" asp-controller="Admin" asp-action="RejectOrder">
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <button type="submit" class="btn btn-danger btn-sm py-0 px-2 fw-bold" style="font-size: 0.75rem;">Reject</button>
                                    </form>
                                </div>
                            }
                            else if (order.Status == "Completed")
                            {
                                <span class="badge bg-success">Approved ✅</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rejected ❌</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>




